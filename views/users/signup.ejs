<%# 

  views/users/signup.ejs

  ---------------------------------------------------------------------------

  PURPOSE:

    The signup form (name, username, email, password).

  DEPENDS ON / INTERACTS WITH:

    Rendered by GET /signup; submits to POST /signup (controllers/users.js signUser).

  ---------------------------------------------------------------------------

%>

<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/css/button-style.css">
<link rel="stylesheet" href="/css/auth-account.css">

<%# <!-- <div class="row mt-3 mx-auto"> 
     <div class="col-md-8 mx-auto"> --> %>

<div id="account-set-main">

    <div id="account-set">

        <h2>SignUp on Airbnb Project</h2>

        <h4 class="mt-2 mb-3">
            Have an account?
            <a href="/login">Log In</a>
        </h4>

        <form
            action="/signup"
            method="post"
            class="needs-validation"
            novalidate
        >

            <div class="mb-3">

                <label for="fName" class="form-label">
                    First Name
                </label>

                <input
                    id="fName"
                    type="text"
                    placeholder="Enter First Name"
                    name="fName"
                    class="form-control border border-black border-opacity-50"
                    minlength="2"
                    maxlength="50"
                    autocomplete="given-name"
                    required
                >

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    First Name should be valid
                </div>

            </div>

            <div class="mb-3">

                <label for="lName" class="form-label">
                    Last Name
                </label>

                <input
                    id="lName"
                    type="text"
                    placeholder="Enter Last Name"
                    name="lName"
                    class="form-control border border-black border-opacity-50"
                    maxlength="50"
                    autocomplete="family-name"
                >

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Last Name should be valid
                </div>

            </div>

            <div class="mb-3">

                <label for="username" class="form-label">
                    Username
                </label>

                <div class="input-group">

                    <span
                        class="input-group-text"
                        id="basic-addon1"
                    >
                        @
                    </span>

                    <input
                        id="username"
                        type="text"
                        placeholder="Enter Username"
                        name="username"
                        class="form-control border border-black border-opacity-50"
                        minlength="3"
                        maxlength="30"
                        autocomplete="username"
                        required
                    >

                </div>

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Username should be valid
                </div>

            </div>

            <div class="mb-3">

                <label for="email" class="form-label">
                    Email
                </label>

                <input
                    id="email"
                    type="email"
                    placeholder="Enter Email"
                    name="email"
                    class="form-control border border-black border-opacity-50"
                    maxlength="100"
                    autocomplete="email"
                    required
                >

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Email should be valid
                </div>

            </div>

            <div class="mb-3">

                <label for="password" class="form-label">
                    Password
                </label>

                <div class="password-field">
                    <input
                        id="password"
                        type="password"
                        placeholder="Enter Password"
                        name="password"
                        class="form-control border border-black border-opacity-50"
                        minlength="8"
                        maxlength="128"
                        autocomplete="new-password"
                        required
                    >
                    <button
                        type="button"
                        class="password-toggle"
                        data-password-toggle="password"
                        aria-label="Show password"
                        aria-pressed="false"
                    >
                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please lengthen this text to 8 characters or more.
                </div>

            </div>

            <div class="form-check mb-2 mr-sm-2">

                <input
                    class="form-check-input mt-2"
                    style="opacity: 1;"
                    type="checkbox"
                    id="inlineFormCheck"
                >

                <label
                    class="form-check-label ms-3 mt-1"
                    for="inlineFormCheck"
                >
                    Remember me
                </label>

            </div>

            <button
                type="submit"
                class="btn btn-primary styleBtn"
            >
                SignUp
            </button>

        </form>

    </div>

</div>

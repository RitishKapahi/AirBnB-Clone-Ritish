<%#

    views/listings/show.ejs

    ---------------------------------------------------------------------------

    PURPOSE:

      Single listing detail page: image, description, price/tax toggle, owner info, an interactive Mapbox map, and the review list + add-review form.

    DEPENDS ON / INTERACTS WITH:

      Rendered by GET /listings/:id (controllers/listings.js showListing). Uses public/js/map.js, public/js/tax-info.js, public/js/delete-confirm.js, public/css/show.css, public/css/rating.css.

    ---------------------------------------------------------------------------

%>

<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/css/show.css">
<link rel="stylesheet" href="/css/delete-confirm.css">
<link rel="stylesheet" href="/css/button-style.css">

<script id="map-data" type="application/json">
    <%- JSON.stringify({
        mapToken,
        listing: {
            title: listing.title,
            location: listing.location,
            country: listing.country,
            geometry: listing.geometry,
        },
    })
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029") %>
</script>

<script>
    const mapData = JSON.parse(
        document.getElementById("map-data").textContent
    );

    const mapToken = mapData.mapToken;
    const listing = mapData.listing;

    // const listing = <%#- JSON.stringify(listing) %>;
</script>

<div class="row mt-3 show-main">

    <div class="show-body">

        <div class="col-8 offset-2">

            <h3 class="ms-3">
                <%= listing.title %>
            </h3>

        </div>

        <div class="card col-8 offset-2 show-card listing-card">

            <div class="show-card-img">

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top show-img"
                    alt="<%= listing.title %>"
                >

            </div>

            <div class="card-body ms-1">

                <p class="card-text">
                    <b>Owned by :</b>
                    <b>
                        <i>
                            @<%= listing.owner?.username || "Unknown" %>
                        </i>
                    </b>
                </p>

                <p class="card-text">
                    <b>Description :</b>
                    <%= listing.description %>
                </p>

                <p class="card-text">
                    <b>Price :</b>
                    &#8377;
                    <%= listing.price.toLocaleString("en-IN") %>
                    / night
                </p>

                <p class="card-text">

                    <b>Country :</b>

                    <%= listing.location %>,
                    <%= listing.country %>

                    <i
                        class="fa-solid fa-location-dot"
                        class="listing-location-icon"
                        aria-hidden="true"
                    ></i>

                </p>

                <p class="card-text">

                    <b>Category :</b>

                    <%= Array.isArray(listing.category)
                        ? listing.category.join(", ")
                        : listing.category %>

                </p>

            </div>

        </div>

        <!-- Authorization  -->

        <% if (
            currUser &&
            listing.owner &&
            currUser._id.equals(listing.owner._id)
        ) { %>

            <div class="btns offset-2">

                <div class="btns-edit">

                    <a
                        href="/listings/<%= listing._id %>/edit"
                        class="btn btn-dark col-1 offset-3 edit-btn styleBtn"
                    >
                        Edit
                    </a>

                    <form
                        method="post"
                        action="/listings/<%= listing._id %>?_method=DELETE"
                        class="needs-validation"
                    >

                        <button
                            type="reset"
                            class="btn btn-danger offset-4 del-btn styleBtn"
                            id="delete-confirm"
                        >
                            Delete
                        </button>

                        <div class="fnx-fixed-dis">

                            <div
                                class="delete-fnx"
                                style="display: none;"
                            >

                                <p>
                                    I want to delete this listing.
                                </p>

                                <p>
                                    "<%= listing.title %>"
                                </p>

                                <div class="conf cancle-confirm">
                                    Cancel
                                </div>

                                <button
                                    type="submit"
                                    class="conf delete-confirm"
                                >
                                    Confirm
                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        <% } %>

        <!-- --------------- review ------------- -->

        <hr class="mt-2">

        <div class="col-8 offset-2">

            <% if (currUser) { %>

                <p>
                    <b>
                        Leave a Review &nbsp;
                        <i class="fa-regular fa-pen-to-square"></i>
                    </b>
                </p>

                <form
                    method="post"
                    action="/listings/<%= listing._id %>/reviews"
                    class="needs-validation"
                    novalidate
                >

                    <div class="mt-3">

                        <label
                            class="form-label"
                            for="rating"
                        >
                            Rating
                        </label>

                        <!--
                        <input
                            class="form-range"
                            type="range"
                            min="1"
                            max="5"
                            name="review[rating]"
                            id="rating"
                        >
                        -->

                        <fieldset
                            class="starability-slot"
                            id="rating"
                        >

                            <input
                                type="radio"
                                id="no-rate"
                                class="input-no-rate"
                                name="review[rating]"
                                value="0"
                                checked
                                aria-label="No rating selected."
                            />

                            <input
                                type="radio"
                                id="first-rate1"
                                name="review[rating]"
                                value="1"
                            />

                            <label
                                for="first-rate1"
                                title="Terrible"
                            >
                                1 star
                            </label>

                            <input
                                type="radio"
                                id="first-rate2"
                                name="review[rating]"
                                value="2"
                            />

                            <label
                                for="first-rate2"
                                title="Not good"
                            >
                                2 stars
                            </label>

                            <input
                                type="radio"
                                id="first-rate3"
                                name="review[rating]"
                                value="3"
                            />

                            <label
                                for="first-rate3"
                                title="Average"
                            >
                                3 stars
                            </label>

                            <input
                                type="radio"
                                id="first-rate4"
                                name="review[rating]"
                                value="4"
                            />

                            <label
                                for="first-rate4"
                                title="Very good"
                            >
                                4 stars
                            </label>

                            <input
                                type="radio"
                                id="first-rate5"
                                name="review[rating]"
                                value="5"
                            />

                            <label
                                for="first-rate5"
                                title="Amazing"
                            >
                                5 stars
                            </label>

                        </fieldset>

                        <div class="invalid-feedback">
                            Please select a rating from 1 to 5.
                        </div>

                    </div>

                    <div class="mb-3">

                        <label
                            class="form-label"
                            for="comment"
                        >
                            Comment
                        </label>

                        <textarea
                            class="form-control"
                            name="review[comment]"
                            id="comment"
                            cols="30"
                            rows="3"
                            minlength="2"
                            maxlength="1000"
                            required
                        ></textarea>

                        <div class="invalid-feedback">
                            Please add some comments for review.
                        </div>

                    </div>

                    <button
                        type="submit"
                        class="btn btn-success mb-3 styleBtn"
                    >
                        Submit
                    </button>

                </form>

            <% } %>

            <% if (listing.reviews.length > 0) { %>

                <p>
                    <b>All Reviews</b>
                </p>

                <div class="row m-1 review-main">

                    <% for (const review of listing.reviews) { %>

                        <div class="card col-xs-4 col-sm-12 col-md-12 col-lg-5 review-lg">

                            <div class="card-body mb-2 review-card">

                                <p
                                    class="starability-result"
                                    data-rating="<%= review.rating %>"
                                ></p>

                                <span class="review-comment-wrap">

                                    <h5 class="card-title">

                                        @<%= review.author?.username || "Unknown User" %>
                                        &nbsp; :

                                    </h5>

                                    <p class="card-text mb-1 review-comment">
                                        <%= review.comment %>
                                    </p>

                                </span>

                                <!--
                                <p class="card-text">
                                    <%# review.rating %> Stars
                                </p>
                                -->

                            </div>

                            <% if (
                                currUser &&
                                review.author &&
                                currUser._id.equals(review.author._id)
                            ) { %>

                                <form
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    class="mb-1 review-del needs-validation"
                                    method="post"
                                >

                                    <!--
                                    <button class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                    -->

                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-danger"
                                        aria-label="Delete review"
                                    >
                                        <i class="fa-solid fa-trash"></i>
                                    </button>

                                </form>

                            <% } %>

                        </div>

                    <% } %>

                </div>

            <% } %>

        </div>

        <!-- Load the `mapbox-gl-geocoder` plugin. -->

        <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.min.js"></script>

        <link
            rel="stylesheet"
            href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.css"
            type="text/css"
        >

        <div class="col-8 offset-2 mapImg">

            <p>

                <b>
                    Where you'll be &nbsp;
                    <i class="fa-solid fa-location-crosshairs"></i>
                </b>

            </p>

            <div
                id="map"
                class="listing-map"
            >

                <div class="map-zoom-icon">

                    <div
                        class="icon icon-plus"
                        onclick="zoomin()"
                        role="button"
                        tabindex="0"
                        aria-label="Zoom in"
                    >
                        <i class="fa-solid fa-magnifying-glass-plus"></i>
                    </div>

                    <div
                        class="icon icon-min"
                        onclick="zoomout()"
                        role="button"
                        tabindex="0"
                        aria-label="Zoom out"
                    >
                        <i class="fa-solid fa-magnifying-glass-minus"></i>
                    </div>

                </div>

                <div class="ritish">

                    <a
                        href="https://github.com/RitishKapahi"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Project GitHub
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="/js/map.js"></script>

<script src="/js/delete-confirm.js"></script>

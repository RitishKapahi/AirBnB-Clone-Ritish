<%# 

  views/users/login.ejs

  ---------------------------------------------------------------------------

  PURPOSE:

    The login form (username + password).

  DEPENDS ON / INTERACTS WITH:

    Rendered by GET /login; submits to POST /login, handled by Passport's local strategy then controllers/users.js loginUser.

  ---------------------------------------------------------------------------

%>

<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/css/button-style.css">
<link rel="stylesheet" href="/css/auth-account.css">

<%# <!-- <div class="row mt-3 mx-auto">
     <div class=" col-md-8 mx-auto"> --> %>

<div id="account-set-main">

    <div id="account-set">

        <h2>LogIn on Airbnb Project</h2>

        <h4 class="mt-2 mb-3">
            Don't have an account?
            <a href="/signup">Sign Up</a>
        </h4>

        <form
            action="/login"
            method="post"
            class="needs-validation"
            novalidate
        >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">

                <label for="username" class="form-label">
                    Username
                </label>

                <div class="input-group">

                    <span
                        class="input-group-text"
                        id="basic-addon1"
                    >
                        @
                    </span>

                    <input
                        id="username"
                        type="text"
                        placeholder="Enter Username"
                        name="username"
                        class="form-control border border-black border-opacity-50"
                        autocomplete="username"
                        required
                    >

                </div>

                <div class="invalid-feedback">
                    Please enter your username.
                </div>

            </div>

            <div class="mb-3">

                <label for="password" class="form-label">
                    Password
                </label>

                <div class="password-field">
                    <input
                        id="password"
                        type="password"
                        placeholder="Enter Password"
                        name="password"
                        class="form-control border border-black border-opacity-50"
                        autocomplete="current-password"
                        required
                    >
                    <button
                        type="button"
                        class="password-toggle"
                        data-password-toggle="password"
                        aria-label="Show password"
                        aria-pressed="false"
                    >
                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="invalid-feedback">
                    Please enter your password.
                </div>

            </div>

            <button
                type="submit"
                class="btn btn-primary styleBtn"
            >
                LogIn
            </button>

        </form>

    </div>

</div>

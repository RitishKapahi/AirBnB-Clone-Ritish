<%#

    views/includes/navbar.ejs

    ---------------------------------------------------------------------------

    PURPOSE:

      The top navigation bar: logo/home link, search box, and the user menu (Login/Signup or Profile/Logout depending on whether res.locals.currUser is set).

    DEPENDS ON / INTERACTS WITH:

      Included by views/layouts/boilerplate.ejs on every page. Interactivity handled by public/js/navbar.js.

    ---------------------------------------------------------------------------

%>

<link rel="stylesheet" href="/css/navbar.css"> <!-- link style file -->

<nav class="nav-box">

    <div id="nav-main">

        <div id="nav-main-bar">

            <div class="nav-icon">

                <a href="/listings">
                    <img
                        class="imgAirbnb"
                        src="/Icon/name-logo.png"
                        alt="Airbnb home"
                    >
                </a>

            </div>

            <div class="nav-search nav-hover nav-search-search">

                <form
                    class="d-flex needs-validation"
                    role="search"
                    action="/listings/search"
                    method="get"
                    id="searchBox-desktop"
                >

                    <input
                        type="search"
                        placeholder="Search"
                        aria-label="Search listings"
                        name="q"
                        id="mySearchInput-desktop"
                    >

                    <button
                        type="submit"
                        id="search-desktop"
                        aria-label="Search"
                    >
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>

                </form>

            </div>

            <div
                class="nav-user nav-hover"
                role="button"
                tabindex="0"
                aria-label="Toggle user menu"
                aria-controls="user-menu"
                aria-haspopup="true"
                aria-expanded="false"
            >

                <div class="nav-user-controls">

                    <span class="nav-menu-icon" aria-hidden="true">
                        <img
                            src="/Icon/navbar-icon.png"
                            id="png-img-bar"
                            alt=""
                        >

                        <img
                            src="/Icon/navbar-icon-cross.png"
                            id="png-img-cross"
                            alt=""
                        >
                    </span>

                    <% if (typeof currUser !== "undefined" && currUser?.image?.url) { %>

                        <img
                            src="<%= currUser.image.url %>"
                            alt="Profile"
                            id="png-img-user"
                        >

                    <% } else { %>

                        <img
                            src="/Icon/navbar-icon-user.png"
                            alt="User"
                            id="png-img-user"
                        >

                    <% } %>

                </div>

            </div>

            <div
                class="user-fnx"
                id="user-menu"
                role="menu"
                style="display: none;"
            >

                <% if (typeof currUser !== "undefined" && currUser) { %>

                    <a href="/profile" role="menuitem">
                        <i class="fa-regular fa-user" aria-hidden="true"></i>
                        <span>Profile</span>
                    </a>

                    <a href="/listings/new" role="menuitem">
                        <i class="fa-solid fa-house" aria-hidden="true"></i>
                        <span>Airbnb your home</span>
                    </a>

                    <% if (typeof isAdmin !== "undefined" && isAdmin) { %>

                        <a href="/admin/listings" role="menuitem">
                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                            <span>Admin panel</span>
                        </a>

                    <% } %>

                    <a href="/logout" role="menuitem">
                        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
                        <span>Log out</span>
                    </a>

                <% } else { %>

                    <a href="/signup" role="menuitem">
                        <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                        <span>Sign up</span>
                    </a>

                    <a href="/login" role="menuitem">
                        <i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i>
                        <span>Log in</span>
                    </a>

                <% } %>

            </div>

        </div>

        <div id="nav-search-hide">

            <div class="nav-search nav-hover">

                <form
                    class="d-flex needs-validation"
                    role="search"
                    action="/listings/search"
                    method="get"
                    id="searchBox-mobile"
                >

                    <input
                        type="search"
                        placeholder="Search"
                        aria-label="Search listings"
                        name="q"
                        id="mySearchInput-mobile"
                    >

                    <button
                        type="submit"
                        id="search-mobile"
                        aria-label="Search"
                    >
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>

                </form>

            </div>

        </div>

    </div>

</nav>

<script src="/js/navbar.js"></script>

<% layout("layouts/boilerplate") %>

<link rel="stylesheet" href="/css/form.css">

<%
    const currentCategory = Array.isArray(listing.category)
        ? (listing.category[0] || "")
        : (listing.category || "");
    const isAdminEdit = typeof adminContext !== "undefined" && adminContext;
    const formAction = isAdminEdit
        ? `/admin/listings/${listing._id}?_method=PUT`
        : `/listings/${listing._id}?_method=PUT`;
    const cancelUrl = isAdminEdit
        ? "/admin/listings"
        : `/listings/${listing._id}`;
%>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <div class="mb-4">
                <h2 class="fw-semibold">
                    <%= isAdminEdit ? "Edit listing" : "Edit your listing" %>
                </h2>
                <p class="text-muted mb-0">
                    <%= isAdminEdit
                        ? "Manage this listing from the administrator panel."
                        : "Update your property's information and amenities." %>
                </p>
            </div>

            <form
                action="<%= formAction %>"
                method="POST"
                enctype="multipart/form-data"
                class="needs-validation listing-form"
                novalidate
            >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="mb-3">
                    <label for="listing-title" class="form-label">
                        Listing title
                    </label>

                    <input
                        type="text"
                        id="listing-title"
                        name="listing[title]"
                        class="form-control"
                        value="<%= listing.title %>"
                        minlength="3"
                        maxlength="100"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a title between 3 and 100 characters.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="listing-description" class="form-label">
                        Description
                    </label>

                    <textarea
                        id="listing-description"
                        name="listing[description]"
                        class="form-control"
                        rows="5"
                        minlength="10"
                        maxlength="2000"
                        required
                    ><%= listing.description %></textarea>

                    <div class="invalid-feedback">
                        Please enter a description of at least 10 characters.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="listing-country" class="form-label">
                        Country
                    </label>

                    <input
                        type="text"
                        id="listing-country"
                        name="listing[country]"
                        class="form-control"
                        value="<%= listing.country %>"
                        minlength="2"
                        maxlength="60"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid country.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="listing-location" class="form-label">
                        Location
                    </label>

                    <input
                        type="text"
                        id="listing-location"
                        name="listing[location]"
                        class="form-control"
                        value="<%= listing.location %>"
                        minlength="2"
                        maxlength="100"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a location.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="listing-price" class="form-label">
                        Price per night (₹)
                    </label>

                    <input
                        type="number"
                        id="listing-price"
                        name="listing[price]"
                        class="form-control"
                        value="<%= listing.price %>"
                        min="0"
                        max="10000000"
                        step="0.01"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="listing-category" class="form-label">
                        Category
                    </label>

                    <select
                        id="listing-category"
                        name="listing[category]"
                        class="form-select"
                    >
                        <option value="" <%= currentCategory === "" ? "selected" : "" %>>
                            Choose a category
                        </option>

                        <option value="Trending" <%= currentCategory === "Trending" ? "selected" : "" %>>
                            Trending
                        </option>

                        <option value="Rooms" <%= currentCategory === "Rooms" ? "selected" : "" %>>
                            Rooms
                        </option>

                        <option value="Iconic cities" <%= currentCategory === "Iconic cities" ? "selected" : "" %>>
                            Iconic cities
                        </option>

                        <option value="Mountains" <%= currentCategory === "Mountains" ? "selected" : "" %>>
                            Mountains
                        </option>

                        <option value="Castles" <%= currentCategory === "Castles" ? "selected" : "" %>>
                            Castles
                        </option>

                        <option value="Amazing pools" <%= currentCategory === "Amazing pools" ? "selected" : "" %>>
                            Amazing pools
                        </option>

                        <option value="Camping" <%= currentCategory === "Camping" ? "selected" : "" %>>
                            Camping
                        </option>

                        <option value="Farms" <%= currentCategory === "Farms" ? "selected" : "" %>>
                            Farms
                        </option>

                        <option value="Arctic" <%= currentCategory === "Arctic" ? "selected" : "" %>>
                            Arctic
                        </option>

                        <option value="Domes" <%= currentCategory === "Domes" ? "selected" : "" %>>
                            Domes
                        </option>

                        <option value="Boats" <%= currentCategory === "Boats" ? "selected" : "" %>>
                            Boats
                        </option>

                        <option value="Cabins" <%= currentCategory === "Cabins" ? "selected" : "" %>>
                            Cabins
                        </option>

                        <option value="Amazing views" <%= currentCategory === "Amazing views" ? "selected" : "" %>>
                            Amazing views
                        </option>

                        <option value="Beachfront" <%= currentCategory === "Beachfront" ? "selected" : "" %>>
                            Beachfront
                        </option>

                        <option value="National parks" <%= currentCategory === "National parks" ? "selected" : "" %>>
                            National parks
                        </option>

                        <option value="Luxe" <%= currentCategory === "Luxe" ? "selected" : "" %>>
                            Luxe
                        </option>
                    </select>
                </div>

                <hr class="my-4">

                <%- include("../includes/listing-details.ejs") %>

                <hr class="my-4">

                <div class="mb-4">
                    <label for="listingImage" class="form-label">
                        Change listing image
                    </label>

                    <div class="mb-3">
                        <img
                            src="<%= listing.image.url %>"
                            class="img-fluid rounded"
                            alt="Current listing image"
                            style="max-width: 100%; max-height: 320px; object-fit: cover;"
                        >
                        <div class="form-text mt-2">
                            Current image
                        </div>
                    </div>

                    <input
                        type="file"
                        id="listingImage"
                        name="listing[image]"
                        class="form-control"
                        accept="image/png,image/jpeg"
                        onchange="previewImage()"
                    >

                    <div class="form-text">
                        Select a new image only if you want to replace the current one.
                        JPG, JPEG or PNG; maximum 100 KB.
                    </div>

                    <div class="mt-3">
                        <img
                            id="imagePreview"
                            class="image-preview img-fluid rounded d-none"
                            alt="New listing image preview"
                            style="max-width: 100%; max-height: 320px; object-fit: cover;"
                        >
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-dark">
                        Save changes
                    </button>

                    <a
                        href="<%= cancelUrl %>"
                        class="btn btn-outline-secondary"
                    >
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

<script src="/js/editImg-size.js"></script>
<script src="/js/image-preview.js"></script>

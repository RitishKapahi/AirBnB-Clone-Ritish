# Copy this file to .env and fill in values locally.
# Never commit the real .env file.

ATLASDB_URL=
SECRET=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
MAP_TOKEN=

# Optional explicit administrator identity. Configure at least one value.
# Comma-separated variants are supported for multiple administrators.
ADMIN_EMAIL=
ADMIN_EMAILS=
ADMIN_USERNAME=
ADMIN_USERNAMES=
ADMIN_USER_ID=

# Optional owner used by scripts/seed-listings.js. If omitted, the oldest
# existing user is used.
SEED_OWNER_EMAIL=
SEED_OWNER_ID=

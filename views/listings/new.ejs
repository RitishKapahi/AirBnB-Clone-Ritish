<% layout("layouts/boilerplate") %>

<link rel="stylesheet" href="/css/form.css">

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <div class="mb-4">
                <h2 class="fw-semibold">Create a new listing</h2>
                <p class="text-muted mb-0">
                    Share your place with guests by adding its details below.
                </p>
            </div>

            <form
                action="/listings"
                method="POST"
                enctype="multipart/form-data"
                class="needs-validation listing-form"
                novalidate
            >

                <div class="mb-3">
                    <label for="listing-title" class="form-label">
                        Listing title
                    </label>

                    <input
                        type="text"
                        id="listing-title"
                        name="listing[title]"
                        class="form-control"
                        placeholder="Add a catchy title"
                        minlength="3"
                        maxlength="100"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a title between 3 and 100 characters.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="listing-description" class="form-label">
                        Description
                    </label>

                    <textarea
                        id="listing-description"
                        name="listing[description]"
                        class="form-control"
                        rows="5"
                        placeholder="Describe your place and what makes it special"
                        minlength="10"
                        maxlength="2000"
                        required
                    ></textarea>

                    <div class="invalid-feedback">
                        Please enter a description of at least 10 characters.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="listing-country" class="form-label">
                        Country
                    </label>

                    <input
                        type="text"
                        id="listing-country"
                        name="listing[country]"
                        class="form-control"
                        placeholder="Enter country"
                        minlength="2"
                        maxlength="60"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid country.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="listing-location" class="form-label">
                        Location
                    </label>

                    <input
                        type="text"
                        id="listing-location"
                        name="listing[location]"
                        class="form-control"
                        placeholder="Enter city or locality"
                        minlength="2"
                        maxlength="100"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a location.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="listing-price" class="form-label">
                        Price per night (₹)
                    </label>

                    <input
                        type="number"
                        id="listing-price"
                        name="listing[price]"
                        class="form-control"
                        placeholder="Enter price per night"
                        min="0"
                        max="10000000"
                        step="0.01"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="listing-category" class="form-label">
                        Category
                    </label>

                    <select
                        id="listing-category"
                        name="listing[category]"
                        class="form-select"
                    >
                        <option value="">Choose a category</option>
                        <option value="Trending">Trending</option>
                        <option value="Rooms">Rooms</option>
                        <option value="Iconic cities">Iconic cities</option>
                        <option value="Mountains">Mountains</option>
                        <option value="Castles">Castles</option>
                        <option value="Amazing pools">Amazing pools</option>
                        <option value="Camping">Camping</option>
                        <option value="Farms">Farms</option>
                        <option value="Arctic">Arctic</option>
                        <option value="Domes">Domes</option>
                        <option value="Boats">Boats</option>
                        <option value="Cabins">Cabins</option>
                        <option value="Amazing views">Amazing views</option>
                        <option value="Beachfront">Beachfront</option>
                        <option value="National parks">National parks</option>
                        <option value="Luxe">Luxe</option>
                    </select>
                </div>

                <hr class="my-4">

                <%- include("../includes/listing-details.ejs") %>

                <hr class="my-4">

                <div class="mb-4">
                    <label for="listingImage" class="form-label">
                        Listing image
                    </label>

                    <input
                        type="file"
                        id="listingImage"
                        name="listing[image]"
                        class="form-control"
                        accept="image/png,image/jpeg"
                        onchange="previewImage()"
                        required
                    >

                    <div class="form-text">
                        JPG, JPEG or PNG only. Maximum file size: 100 KB.
                    </div>

                    <div class="invalid-feedback">
                        Please select a listing image.
                    </div>

                    <div class="mt-3">
                        <img
                            id="imagePreview"
                            class="image-preview img-fluid rounded d-none"
                            alt="Listing image preview"
                            style="max-width: 100%; max-height: 320px; object-fit: cover;"
                        >
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-dark">
                        Create listing
                    </button>

                    <a href="/listings" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

<script src="/js/newImg-size.js"></script>
<script src="/js/image-preview.js"></script>

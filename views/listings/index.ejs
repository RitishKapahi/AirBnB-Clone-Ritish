<% if (!Array.isArray(allListing) || allListing.length === 0) { %>
    <section class="empty-state" aria-live="polite">
        <div class="empty-state-icon" aria-hidden="true">
            <i class="fa-regular fa-compass"></i>
        </div>
        <h2>No stays match these filters</h2>
        <p>Try widening your search or clearing the filters to discover more places to stay.</p>
        <a href="/listings" class="styleBtn text-decoration-none">Clear filters</a>
    </section>
<% } else { %>
    <div class="listing-results-summary" aria-live="polite">
        <span>
            Showing <strong><%= pagination.firstItem %>–<%= pagination.lastItem %></strong>
            of <strong><%= pagination.totalCount %></strong> stays
        </span>
        <span>20 stays per page</span>
    </div>

    <div
        class="row listing-grid row-cols-xxl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-1"
    >

    <% for (const listing of allListing) { %>

        <% const isFavorite =
            typeof favoriteIds !== "undefined" &&
            Array.isArray(favoriteIds) &&
            favoriteIds.includes(String(listing._id)); %>
        <% const cardReviews = Array.isArray(listing.reviews) ? listing.reviews : []; %>
        <% const averageRating = cardReviews.length
            ? cardReviews.reduce((sum, review) => sum + Number(review.rating || 0), 0) / cardReviews.length
            : null; %>

        <a
            href="/listings/<%= listing._id %>"
            class="listing-link"
        >

            <div class="card col listing-card index-res">

                <div class="index-res-img">

                    <div class="card-img">

                        <img
                            class="heart heart-r <%= isFavorite ? "" : "d-none" %>"
                            src="/Icon/heart-red.png"
                            alt="Remove listing from favourites"
                            data-favorite-id="<%= listing._id %>"
                            data-authenticated="<%= currUser ? "true" : "false" %>"
                            aria-pressed="<%= isFavorite %>"
                            role="button"
                            style="opacity: 1; z-index: 5;"
                        >

                        <img
                            class="heart heart-b <%= isFavorite ? "d-none" : "" %>"
                            src="/Icon/heart-black.png"
                            alt="Add listing to favourites"
                            data-favorite-id="<%= listing._id %>"
                            data-authenticated="<%= currUser ? "true" : "false" %>"
                            aria-pressed="<%= isFavorite %>"
                            role="button"
                            style="z-index: 6;"
                        >

                        <img
                            src="<%= listing.image?.url || "/Icon/listing-img-pre.png" %>"
                            class="card-img-top"
                            alt="<%= listing.title %>"
                        >

                    </div>

                    <!-- set date  -->

                    <%
                        let day =
                            Math.floor(Math.random() * 4 + 2);

                        let no =
                            Math.floor(Math.random() * 28 + 1);

                        let date =
                            (new Date("2024-09-10")).getDate() +
                            no;

                        let dateA =
                            (new Date("2024-09-10")).getDate() +
                            no +
                            day;

                        let month =
                            Date().split(" ")[1];
                    %>

                    <div class="card-body mt-1 ms-2">

                        <div class="listing-card-meta">

                            <div class="listing-card-heading">
                                <p class="listing-card-title">
                                    <%= listing.title %>
                                </p>

                                <% if (averageRating !== null) { %>
                                    <span
                                        class="listing-card-rating"
                                        aria-label="Rated <%= averageRating.toFixed(1) %> out of 5 from <%= cardReviews.length %> reviews"
                                    >
                                        <i class="fa-solid fa-star" aria-hidden="true"></i>
                                        <%= averageRating.toFixed(1) %>
                                    </span>
                                <% } %>
                            </div>

                            <p class="listing-card-location">
                                <%= listing.location %>, <%= listing.country %>
                            </p>

                            <p class="listing-card-stay">
                                <span class="tax-info">
                                    <%= day %> nights <span aria-hidden="true">•</span>
                                </span>
                                <span><%= date %>–<%= dateA %> <%= month %></span>
                            </p>

                            <p class="listing-card-price">

                                <span class="price-info">
                                    <strong>&#8377;<%= listing.price.toLocaleString("en-IN") %></strong>
                                    <span>night</span>
                                </span>

                                <span class="tax-info tax-total tax-underline">
                                    <strong>&#8377;<%= (listing.price * 1.18).toLocaleString("en-IN") %></strong>
                                    <span>total after taxes</span>
                                </span>

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </a>

    <% } %>

    </div>

    <% if (pagination.totalPages > 1) { %>
        <nav class="listing-pagination" aria-label="Listing pages">
            <% if (pagination.page > 1) { %>
                <a
                    class="listing-page-control listing-page-previous"
                    href="<%= pagination.basePath %>?<%= pagination.queryString ? pagination.queryString + '&' : '' %>page=<%= pagination.page - 1 %>"
                    rel="prev"
                    aria-label="Go to previous page"
                >
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    <span>Previous</span>
                </a>
            <% } else { %>
                <span class="listing-page-control is-disabled" aria-disabled="true">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    <span>Previous</span>
                </span>
            <% } %>

            <div class="listing-page-numbers">
                <% for (const pageNumber of pagination.pageNumbers) { %>
                    <% if (pageNumber === null) { %>
                        <span class="listing-page-ellipsis" aria-hidden="true">…</span>
                    <% } else if (pageNumber === pagination.page) { %>
                        <span class="listing-page-number is-current" aria-current="page"><%= pageNumber %></span>
                    <% } else { %>
                        <a
                            class="listing-page-number"
                            href="<%= pagination.basePath %>?<%= pagination.queryString ? pagination.queryString + '&' : '' %>page=<%= pageNumber %>"
                            aria-label="Go to page <%= pageNumber %>"
                        ><%= pageNumber %></a>
                    <% } %>
                <% } %>
            </div>

            <% if (pagination.page < pagination.totalPages) { %>
                <a
                    class="listing-page-control listing-page-next"
                    href="<%= pagination.basePath %>?<%= pagination.queryString ? pagination.queryString + '&' : '' %>page=<%= pagination.page + 1 %>"
                    rel="next"
                    aria-label="Go to next page"
                >
                    <span>Next</span>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
            <% } else { %>
                <span class="listing-page-control is-disabled" aria-disabled="true">
                    <span>Next</span>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </span>
            <% } %>
        </nav>
        <p class="listing-page-caption">Page <%= pagination.page %> of <%= pagination.totalPages %></p>
    <% } %>
<% } %>

<script
    defer
    src="/js/filter.js"
></script>


<%#

    views/profiles/profile.ejs

    ---------------------------------------------------------------------------

    PURPOSE:

      The logged-in user's dashboard: profile info plus tabs listing every listing they own and every review they've authored, with per-item and bulk delete actions.

    DEPENDS ON / INTERACTS WITH:

      Rendered by GET /profile (controllers/profiles.js profile). Uses public/js/profile.js, public/js/delete-confirm.js, public/css/profile.css.

    ---------------------------------------------------------------------------

%>

<% layout("/layouts/boilerplate") %>

<!-- is layout use karne se html ka set custome boilerplate milta h -->

<link rel="stylesheet" href="/css/profile.css">

<link rel="stylesheet" href="/css/delete-confirm.css">

<div>

    <div class="main-profiles profile-dashboard mt-2">

        <div class="main-profile-detail">

            <div class="profile-img">

                <% if (!currUser.image?.url) { %>

                    <img
                        src="/Icon/navbar-icon-user.png"
                        alt="Profile photo"
                    >

                <% } else { %>

                    <img
                        src="<%= currUser.image.url %>"
                        alt="Profile photo"
                    >

                <% } %>

                <div id="change-image">

                    <a
                        href="/change-image/<%= currUser._id %>"
                        aria-label="Change profile image"
                    >
                        <i class="fa-solid fa-camera"></i>
                    </a>

                </div>

            </div>

            <div class="profile-user">

                <h3>
                    <span>Name : </span>

                    <%= currUser.fName.charAt(0).toUpperCase() %><%= currUser.fName.slice(1).toLowerCase() %>

                    <% if (currUser.lName) { %>
                        &nbsp;<%= currUser.lName %>
                    <% } %>
                </h3>

                <h3>
                    <span>Username : </span>
                    @<%= currUser.username %>
                </h3>

                <h4>

                    <span>Email : </span>

                    <%
                        const emailParts = currUser.email.split("@");
                        const emailName = emailParts[0] || "";
                        const emailDomain = emailParts[1] || "";
                        const maskedEmail =
                            emailName.length > 2
                                ? `${emailName.slice(0, 2)}xxxxx@${emailDomain}`
                                : currUser.email;
                    %>

                    <%= maskedEmail %>

                </h4>

            </div>

            <div class="manage">

                <form
                    action="/update-form/<%= currUser._id %>"
                    method="get"
                >

                    <button
                        type="submit"
                        class="update"
                    >
                        Account settings
                    </button>

                </form>

                <form
                    method="post"
                    action="/delete/<%= currUser._id %>?_method=DELETE"
                    class="needs-validation"
                >

                    <button
                        type="reset"
                        class="list-btn list-delete"
                    >
                        Delete account
                    </button>

                    <div class="fnx-fixed-dis">

                        <div
                            class="delete-fnx"
                            style="display: none;"
                        >

                            <p>
                                <b>Are you sure</b>
                            </p>

                            <p>
                                you want to delete your account?
                            </p>

                            <div class="conf cancle-confirm">
                                Cancel
                            </div>

                            <button
                                type="submit"
                                class="conf delete-confirm"
                            >
                                Confirm
                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

        <div class="manage manage-hide">

            <form
                action="/update-form/<%= currUser._id %>"
                method="get"
            >

                <button
                    type="submit"
                    class="update"
                >
                        Account settings
                </button>

            </form>

            <form
                method="post"
                action="/delete/<%= currUser._id %>?_method=DELETE"
                class="needs-validation"
            >

                <button
                    type="reset"
                    class="list-btn list-delete"
                >
                        Delete account
                </button>

                <div class="fnx-fixed-dis">

                    <div
                        class="delete-fnx"
                        style="display: none;"
                    >

                        <p>
                            <b>Are you sure</b>
                        </p>

                        <p>
                            you want to delete your account?
                        </p>

                        <div class="conf cancle-confirm">
                            Cancel
                        </div>

                        <button
                            type="submit"
                            class="conf delete-confirm"
                        >
                            Confirm
                        </button>

                    </div>

                </div>

            </form>

        </div>

        <div class="choose-list" role="tablist" aria-label="Profile activity">

            <div>

                <label for="listBtn">
                    <b>My listings</b>
                </label>

                <input
                    type="radio"
                    name="listing"
                    id="listBtn"
                    role="tab"
                    aria-controls="listing-box"
                    aria-selected="true"
                    checked
                >

            </div>

            <div>

                <label for="reviBtn">
                    <b>My reviews</b>
                </label>

                <input
                    type="radio"
                    name="listing"
                    id="reviBtn"
                    role="tab"
                    aria-controls="review-box"
                    aria-selected="false"
                >

            </div>

        </div>

    </div>

    <!-- listings show -->

    <div id="listing-box">

        <div class="listing-count">

            <h3 class="index-res">

                @<%= currUser.username %> Created&nbsp;

                <b class="text-success fs-4">
                    <%= allListing.length %>
                </b>

                &nbsp;Listings

            </h3>

            <form
                method="post"
                action="/profile/all-listings-delete/<%= currUser._id %>?_method=DELETE"
                class="needs-validation"
            >

                <a
                    href="/listings/new"
                    class="deleteAll create-list"
                >
                    Create listing
                </a>

                <button
                    type="reset"
                    class="deleteAll delete-list"
                >
                    Delete all listings
                </button>

                <div class="fnx-fixed-dis">

                    <div
                        class="delete-fnx"
                        style="display: none;"
                    >

                        <p>
                            Are you sure you want to delete the entire listings?
                        </p>

                        <div class="conf cancle-confirm">
                            Cancel
                        </div>

                        <button
                            type="submit"
                            class="conf delete-confirm"
                        >
                            Confirm
                        </button>

                    </div>

                </div>

            </form>

        </div>

        <% if (allListing.length === 0) { %>
            <div class="profile-empty" role="status">
                <i class="fa-regular fa-compass" aria-hidden="true"></i>
                <h4>No listings yet</h4>
                <p>Create your first listing and it will appear here.</p>
                <a href="/listings/new" class="styleBtn text-decoration-none">Create listing</a>
            </div>
        <% } else { %>
            <div
                class="row row-cols-xxl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-1 profile-box"
            >

            <% for (const listing of allListing) { %>

                <div class="listing-link">

                    <div class="card col listing-card index-res">

                        <div class="index-res-img">

                            <div class="card-img">

                                <img
                                    src="<%= listing.image.url %>"
                                    class="card-img-top"
                                    alt="<%= listing.title %>"
                                >

                            </div>

                            <div class="card-body mt-1 ms-2">

                                <p
                                    class="card-text"
                                    style="display: block;"
                                >

                                    <b>
                                        <%= listing.title %>
                                    </b>

                                    <br>

                                    <span>
                                        &nbsp;<%= listing.location %>, <%= listing.country %>
                                    </span>

                                </p>

                            </div>

                            <div class="lists-btn mt-1">

                                <a
                                    href="/listings/<%= listing._id %>"
                                    class="list-btn list-show"
                                >
                                    Show
                                </a>

                                <form
                                    method="post"
                                    action="/profile/listing/<%= listing._id %>?_method=DELETE"
                                    class="needs-validation"
                                >

                                    <button
                                        type="reset"
                                        class="list-btn list-delete"
                                    >
                                        Delete
                                    </button>

                                    <div class="fnx-fixed-dis">

                                        <div
                                            class="delete-fnx"
                                            style="display: none;"
                                        >

                                            <p>
                                                I want to delete this listing.
                                            </p>

                                            <p>
                                                "<%= listing.title %>"
                                            </p>

                                            <div class="conf cancle-confirm">
                                                Cancel
                                            </div>

                                            <button
                                                type="submit"
                                                class="conf delete-confirm"
                                            >
                                                Confirm
                                            </button>

                                        </div>

                                    </div>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            <% } %>

            </div>
        <% } %>

    </div>

    <!-- reviews show -->

    <div
        id="review-box"
        style="display: none;"
    >

        <div class="listing-count">

            <h3 class="index-res">

                @<%= currUser.username %> Created&nbsp;

                <b class="text-success fs-4">
                    <%= allReview.length %>
                </b>

                &nbsp;Reviews

            </h3>

            <form
                method="post"
                action="/profile/all-reviews-delete/<%= currUser._id %>?_method=DELETE"
                class="needs-validation"
            >

                <button
                    type="reset"
                    class="deleteAll delete-list"
                >
                    Delete all reviews
                </button>

                <div class="fnx-fixed-dis">

                    <div
                        class="delete-fnx"
                        style="display: none;"
                    >

                        <p>
                            Are you sure you want to delete the entire reviews?
                        </p>

                        <div class="conf cancle-confirm">
                            Cancel
                        </div>

                        <button
                            type="submit"
                            class="conf delete-confirm"
                        >
                            Confirm
                        </button>

                    </div>

                </div>

            </form>

        </div>

        <% if (allReview.length === 0) { %>
            <div class="profile-empty" role="status">
                <i class="fa-regular fa-comment-dots" aria-hidden="true"></i>
                <h4>No reviews yet</h4>
                <p>Your reviews will appear here after you share your stay experience.</p>
                <a href="/listings" class="styleBtn text-decoration-none">Explore listings</a>
            </div>
        <% } else { %>
            <div
                class="row row-cols-xxl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-1 profile-box"
            >

            <% for (const review of allReview) { %>

                <% const reviewListingId = review.listing?._id || review.listing; %>

                <div class="listing-link">

                    <div class="card col listing-card index-res">

                        <div class="index-res-img">

                            <div
                                class="card-body mt-1 ms-2 review-body"
                            >

                                <span>
                                    <b>Date :</b>

                                    <%= review.createdAt.toLocaleDateString("en-IN") %>
                                </span>

                                <br>

                                <span>
                                    <b>Time :</b>

                                    <%= review.createdAt.toLocaleTimeString("en-IN", {
                                        hour: "2-digit",
                                        minute: "2-digit",
                                        second: "2-digit"
                                    }) %>
                                </span>

                                <br>

                                <span>
                                    <b>Comment :</b>

                                    <%= review.comment %>
                                </span>

                                <br>

                                <span class="ratingBox">

                                    <b>Rating : &nbsp;</b>

                                    <p
                                        class="starability-result"
                                        data-rating="<%= review.rating %>"
                                    ></p>

                                </span>

                            </div>

                            <div class="lists-btn mt-1">

                                <a
                                    href="/listings/<%= reviewListingId %>"
                                    class="list-btn list-show"
                                >
                                    Show
                                </a>

                                <form
                                    method="post"
                                    action="/profile/review/<%= reviewListingId %>/<%= review._id %>?_method=DELETE"
                                    class="needs-validation"
                                >

                                    <button
                                        type="reset"
                                        class="list-btn list-delete"
                                    >
                                        Delete
                                    </button>

                                    <div class="fnx-fixed-dis">

                                        <div
                                            class="delete-fnx"
                                            style="display: none;"
                                        >

                                            <p>
                                                I want to delete this review.
                                            </p>

                                            <p>
                                                "<%= review.comment %>"
                                            </p>

                                            <div class="conf cancle-confirm">
                                                Cancel
                                            </div>

                                            <button
                                                type="submit"
                                                class="conf delete-confirm"
                                            >
                                                Confirm
                                            </button>

                                        </div>

                                    </div>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            <% } %>

            </div>
        <% } %>

    </div>

</div>

<script src="/js/delete-confirm.js"></script>

<script src="/js/profile.js"></script>
